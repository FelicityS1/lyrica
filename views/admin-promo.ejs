<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Set Admin</title>
</head>
<body>

    <div class="container- px-0">
            <!-- Header Section -->
            <div class="admin-header">
                <div class="admin-header__title">
                    <h1>LYRICA - ADMIN PANEL</h1>
                </div>
                <% if (users && users.name) { %>
                    <div class="admin-header__user-section">
                        <span class="admin-header__welcome">Welcome, <%= users.name %>!</span>
                        <a href="/logout" class="admin-header__logout">Logout</a>
                    </div>
                <% } else { %>
                    <a href="/login" class="admin-header__logout">Login</a>
                <% } %>
            </div>
    
            <!-- Navigation Bar -->
            <nav class="navbar navbar-expand-lg navbar-light bg-light admin-navbar">
                <div class="container-fluid">
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
    
                    <div class="collapse navbar-collapse" id="navbarNav">
                        <ul class="admin-navbar">
                            <li class="<%= activePage === 'admin-home' ? 'active' : '' %>">
                                <a href="/admin-home">DASHBOARD</a>
                            </li>
                            <li class="<%= activePage === 'admin-musicfeed' ? 'active' : '' %>">
                                <a href="/admin-musicfeed">MUSIC FEED</a>
                            </li>
                            <li class="<%= activePage === 'admin-users' ? 'active' : '' %>">
                                <a href="/admin-users">MANAGE USERS</a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
    
            <form id="searchForm" class="d-flex">
                <input id="searchInput" class="form-control me-2" type="search" placeholder="Search" aria-label="Search">
            </form>
            <div id="liveSearchResults" class="live-search-results"></div>                    
            
        </div>
    </div>
    </nav>

</div>
    <h2>Promote User to Admin</h2>

    <form id="adminForm">
        <label for="userId">User ID:</label>
        <input type="text" id="userId" name="userId" required>
        <button type="submit">Make Admin</button>
    </form>

    <p id="responseMessage"></p>

    <script>
        document.getElementById("adminForm").addEventListener("submit", async function(event) {
            event.preventDefault();

            const userId = document.getElementById("userId").value;

            const response = await fetch("/set-admin", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({ userId })
            });

            const result = await response.json();
            document.getElementById("responseMessage").innerText = result.message;
        });
    </script>
</body>
</html>
