<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <title>SignUp - Lyrica</title>
    <link rel="stylesheet" href="logins.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@900&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script> <!-- Toast Notification -->
</head>

<body>
    <div class="container- px-0">
        <!-- Header Section -->
        <div class="header">
            <div class="header__title-search">
                <h1>LYRICA</h1>
            </div>
        </div>

        <div class="form-container">
            <h2>SignUp</h2>
            <form id="signupForm">
                <div class="form-group">
                    <label for="username">Username:</label>
                    <input type="text" id="username" name="username" placeholder="Enter your username" required autocomplete="off">
                </div>
                <div class="form-group">
                    <label for="password">Password:</label>
                    <input type="password" id="password" name="password" placeholder="Enter your password" required>
                </div>
                <button type="submit" class="submit-btn">SignUp</button>
            </form>
            <p>Already have an account? <a href="/login">Log In</a></p>
        </div>
    </div>

    <!-- Toast Notification & Form Submission Script -->
    <script>
        document.getElementById("signupForm").addEventListener("submit", async function(event) {
            event.preventDefault(); // Prevent form from reloading the page
    
            const username = document.getElementById("username").value;
            const password = document.getElementById("password").value;
    
            try {
                const response = await fetch("/signup", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ username, password })
                });
    
                const result = await response.json();
    
                if (result.success) {
                    Swal.fire({
                        position: "center", // Popup appears in the center of the form
                        icon: "success",
                        title: "User successfully created!",
                        timer: 2000,
                        showConfirmButton: false,
                        width: "320px", // Keeps the popup smaller
                        timerProgressBar: true
                    }).then(() => {
                        window.location.href = "/login"; // Redirect after success
                    });
                } else {
                    Swal.fire({
                        position: "center", // Popup appears in the center
                        icon: "error",
                        title: result.message,
                        timer: 2000,
                        showConfirmButton: false,
                        width: "320px", // Keeps the popup smaller
                        timerProgressBar: true
                    });
                }
            } catch (error) {
                Swal.fire({
                    position: "center", // Popup appears in the center
                    icon: "error",
                    title: "Something went wrong.",
                    timer: 2000,
                    showConfirmButton: false,
                    width: "320px", // Keeps the popup smaller
                    timerProgressBar: true
                });
            }
        });
    </script>
    
    
</body>
</html>
