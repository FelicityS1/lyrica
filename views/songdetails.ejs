<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SONG DETAILS - Lyrica</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <link rel="stylesheet" href="/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Kalnia&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=League+Spartan:wght@600&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@900&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400&display=swap" rel="stylesheet">

</head>

<body>

    <div class="container- px-0">
         
        <!-- Header Section -->
        <div class="header">
            <div class="header__title-search">
                <h1>LYRICA</h1>
            </div>
            <% if (users && users.name) { %>
                <div class="header__user-section">
                    <span class="header__welcome">Welcome, <%= users.name %>!</span>
                    <a href="/logout" class="header__logout">Logout</a>
                </div>
            <% } else { %>
                <a href="/login" class="header__logout">Login</a>
            <% } %>
        </div>

        <div class="songdetails-container">
            <div class="song-title"><%= song.title %></div>
            <div class="song-artist">By <%= song.artist %></div>
    
            <div class="lyrics-section">
                <div class="lyrics-title">Lyrics:</div>
                <pre><%= song.lyrics %></pre>

            </div>
    
            <div class="youtube-section">
                <div class="video-title">Listen to the song:</div>
                <iframe width="560" height="315" 
                    src="<%= song.youtube.replace('watch?v=', 'embed/') %>" 
                    frameborder="0" 
                    allowfullscreen>
                </iframe>
            </div>
    
            <a href="/musicfeed" class="back-button">Back to Song List</a>
        </div>

</body>
</html>