<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= song.title %> - <%= song.artist %></title>
    <link rel="stylesheet" href="/styles.css"> 
</head>
<body>
    <div class="song-container">
        <h1><%= song.title %> - <%= song.artist %></h1>
        <div class="lyrics-box">
            <h2>Lyrics</h2>
            <p><%= song.lyrics.replace(/\n/g, "<br>") %></p> 
        </div>
        <div class="video-box">
            <h2>Watch the Music Video</h2>
            <iframe width="560" height="315" 
                src="https://www.youtube.com/embed/<%= new URL(song.youtubeURL).searchParams.get('v') %>" 
                frameborder="0" 
                allowfullscreen>
            </iframe>
        </div>
        <a href="/musicfeed">⬅ Back to Music List</a>
    </div>
</body>
</html>
