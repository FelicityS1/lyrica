<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= song.title %> - <%= song.artist %></title>
    <link rel="stylesheet" href="/styles.css"> <!-- Link your CSS -->
</head>
<body>

    <div class="songdetails-container">
        <h1><%= song.title %></h1>
        <h2>By <%= song.artist %></h2>

        <div class="lyrics-section">
            <h3>Lyrics:</h3>
            <p><%= song.lyrics.replace(/\n/g, "<br>") %></p> <!-- Show lyrics with line breaks -->
        </div>

        <div class="youtube-section">
            <h3>Listen to the song:</h3>
            <iframe width="560" height="315" 
                src="<%= song.youtube.replace('watch?v=', 'embed/') %>" 
                frameborder="0" 
                allowfullscreen>
            </iframe>
        </div>

        <a href="/musicfeed" class="back-button">Back to Song List</a>
    </div>

</body>
</html>
