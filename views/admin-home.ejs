<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin - Lyrica</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <link rel="stylesheet" href="/style.css"> 
    <link href="https://fonts.googleapis.com/css2?family=Kalnia&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=League+Spartan:wght@600&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@900&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400&display=swap" rel="stylesheet">
</head>

<body>
    <div class="container- px-0">
            
                            <!-- Header Section -->
        <div class="admin-header">
            <div class="admin-header__title">
                <h1>LYRICA - ADMIN PANEL</h1>
            </div>
            <% if (users && users.name) { %>
                <div class="admin-header__user-section">
                    <span class="admin-header__welcome">Welcome, <%= users.name %>!</span>
                    <a href="/logout" class="admin-header__logout">Logout</a>
                </div>
            <% } else { %>
                <a href="/login" class="admin-header__logout">Login</a>
            <% } %>
        </div>

        <!-- Navigation Bar -->
        <nav class="navbar navbar-expand-lg navbar-light bg-light admin-navbar">
            <div class="container-fluid">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="admin-navbar">
                        <li class="<%= activePage === 'admin-home' ? 'active' : '' %>">
                            <a href="/admin-home">DASHBOARD</a>
                        </li>
                        <li class="<%= activePage === 'admin-musicfeed' ? 'active' : '' %>">
                            <a href="/admin-musicfeed">MUSIC FEED</a>
                        </li>
                        <li class="<%= activePage === 'admin-users' ? 'active' : '' %>">
                            <a href="/admin-users">MANAGE USERS</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        <form id="searchForm" class="d-flex">
            <input id="searchInput" class="form-control me-2" type="search" placeholder="Search" aria-label="Search">
        </form>
        <div id="liveSearchResults" class="live-search-results"></div>                    
        
    </div>
</div>
</nav>

        <!-- Main content section -->
        <div class="content">
            <h1>Admin Dashboard</h1>
            <div class="separator"></div>

                    
                     <!-- Newly Submitted Songs -->
        <div class="table__section">
            <h2>Newly Submitted Songs</h2>
            <div class="table__container table-responsive">
                <table class="table table-hover table-bordered table-custom">
                    <thead>
                        <tr>
                            <th>Song Title</th>
                            <th>Artist</th>
                            <th>Submitted By</th>
                            <th>Date Submitted</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (newSongs && newSongs.length > 0) { %>
                            <% newSongs.forEach(song => { %>
                                <tr>
                                    <td><%= song.title %></td>
                                    <td><%= song.artist %></td>
                                    <td><%= song.submittedBy %></td>
                                    <td><%= new Date(song.createdAt).toLocaleString('en-US', { timeZone: 'Asia/Manila', year: 'numeric', month: 'short', day: 'numeric' }) %></td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="4">No new songs submitted.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Recently Modified Songs -->
        <div class="table__section">
            <h2>Recently Modified Songs</h2>
            <div class="table__container table-responsive">
                <table class="table table-hover table-bordered table-custom">
                    <thead>
                        <tr>
                            <th>Song Title</th>
                            <th>Artist</th>
                            <th>Modified By</th>
                            <th>User/Admin</th>
                            <th>Date Modified</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (modifiedSongs && modifiedSongs.length > 0) { %>
                            <% modifiedSongs.forEach(song => { %>
                                <tr>
                                    <td><%= song.title %></td>
                                    <td><%= song.artist %></td>
                                    <td><%= song.modifiedBy %></td>
                                    <td><%= song.modifiedByRole %></td>
                                    <td><%= new Date(song.dateModified).toLocaleString('en-US', { timeZone: 'Asia/Manila', year: 'numeric', month: 'short', day: 'numeric' }) %></td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="5">No recent modifications.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Recently Deleted Songs -->
        <div class="table__section">
            <h2>Recently Deleted Songs</h2>
            <div class="table__container table-responsive">
                <table class="table table-hover table-bordered table-custom">
                    <thead>
                        <tr>
                            <th>Song Title</th>
                            <th>Artist</th>
                            <th>Deleted By</th>
                            <th>User/Admin</th>
                            <th>Date Deleted</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (deletedSongs && deletedSongs.length > 0) { %>
                            <% deletedSongs.forEach(song => { %>
                                <tr>
                                    <td><%= song.title %></td>
                                    <td><%= song.artist %></td>
                                    <td><%= song.deletedBy %></td>
                                    <td><%= song.deletedByRole %></td>
                                    <td><%= new Date(song.dateDeleted).toLocaleString('en-US', { timeZone: 'Asia/Manila', year: 'numeric', month: 'short', day: 'numeric' }) %></td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="5">No recent deletions.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>



        <!-- Footer Section -->
        <footer class="footer">
            <p>&copy; 2024 Lyrica Admin Panel. All Rights Reserved.</p>
        </footer>

        <!-- Bootstrap Scripts -->
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM"
            crossorigin="anonymous"></script>
</body>

</html>
