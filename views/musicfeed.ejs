<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Music Feed - Lyrica</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <link rel="stylesheet" href="style.css">
    <link href="https://fonts.googleapis.com/css2?family=Kalnia&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=League+Spartan:wght@600&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@900&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400&display=swap" rel="stylesheet">

</head>

<body>

    <div class="container- px-0">
        
        <!-- Header Section -->
        <div class="header">
            <div class="header__title-search">
                <h1>LYRICA</h1>
            </div>
            <a href="/login" class="header__logout">Logout</a>
        </div>

        <!-- Navigation Bar -->
        <nav class="navbar navbar-expand-lg navbar-light bg-light">
            <div class="container-fluid">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item mx-5">
                            <a class="nav-link active" aria-current="page" href="/home">HOME</a>
                        </li>
                        <li class="nav-item dropdown mx-5">
                            <a class="nav-link dropdown-toggle" href="#Genres" id="navbarDropdownMenuLink" role="button"
                                data-bs-toggle="dropdown" aria-expanded="false">
                                GENRES
                            </a>
                            <ul class="dropdown-menu navbar__dropdown--content"
                                aria-labelledby="navbarDropdownMenuLink">
                                <li><a class="dropdown-item" href="GENREJPop.html">J-pop</a></li>
                                <li><a class="dropdown-item" href="GENREPopRock.html">Pop Rock</a></li>
                                <li><a class="dropdown-item" href="GENREPopMusic.html">Pop Music</a></li>
                                <li><a class="dropdown-item" href="GENREAlternative.html">Alternative</a></li>
                                <li><a class="dropdown-item" href="GENREPostHardcore.html">Post Hardcore</a></li>
                                <li><a class="dropdown-item" href="GENRER&B.html">R&B</a></li>
                                <li><a class="dropdown-item" href="GENRESoul.html">Soul</a></li>
                                <li><a class="dropdown-item" href="GENREContemporary.html">Contemporary</a></li>
                                <li><a class="dropdown-item" href="GENREGospel.html">Gospel</a></li>
                            </ul>
                        </li>
                        <li class="nav-item mx-5">
                            <a class="nav-link" href="about.html">ABOUT</a>
                        </li>
                        <li class="nav-item mx-5">
                            <a class="nav-link" href="feedback.html">FEEDBACK</a>
                        </li>
                        <li class="nav-item mx-5">
                            <a class="nav-link" href="addsongs">ADD SONGS</a>
                        </li>
                        <li class="nav-item mx-5">
                            <a class="nav-link" href="musicfeed">MUSIC FEED</a>
                        </li>
                    </ul>

                    <form id="searchForm" class="d-flex">
                        <input id="searchInput" class="form-control me-2" type="search" placeholder="Search" aria-label="Search">
                    </form>
                    <div id="liveSearchResults" class="live-search-results"></div>                    
                    
                </div>
            </div>
        </nav>

        <!-- Music Section -->
        <div class="musicfeed-container">
            <h2>Available Songs</h2>

            <div class="musicfeed-list">
                <% if (typeof songs !== "undefined" && songs.length > 0) { %>
                    <ul>
                        <% songs.forEach(song => { %>
                            <li class="musicfeed-item">
                                <a href="/musicfeed/<%= song._id %>">
                                    <%= song.title %> - <%= song.artist %>
                                </a>
                                <form action="/delete/<%= song._id %>" method="POST" style="margin-left: 10px;">
                                    <button type="submit" class="delete-button">Delete</button>
                                </form>
                            </li>
                        <% }) %>
                    </ul>
                <% } else { %>
                    <p class="musicfeed-empty">No songs have been submitted yet.</p>
                <% } %>
            </div>
        </div>
        
        <!-- Footer Section -->
        <footer class="footer">
            <div class="footer__container">
                <div class="footer__section footer__section--left">
                    <h3 class="footer__heading footer__heading--brand">LYRICA</h3>
                    <p class="footer__text">&copy; 2024 Lyrica. All Rights Reserved.</p>
                </div>

                <div class="footer__section footer__section--center">
                    <ul class="footer__nav">
                        <li class="footer__nav-item"><a href="#" id="contactLink" class="footer__nav-link">Contact</a></li>
                        <li class="footer__nav-item"><a href="#" class="footer__nav-link">Privacy Policy</a></li>
                        <li class="footer__nav-item"><a href="#" class="footer__nav-link">Terms of Service</a></li>
                    </ul>
                </div>
            </div>
        </footer>

        <!-- Modal Container -->
        <div id="modal-container"></div>
        <script src="script.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM"
            crossorigin="anonymous"></script>

        <script>
            document.addEventListener("DOMContentLoaded", () => {
                document.querySelectorAll(".delete-btn").forEach(button => {
                    button.addEventListener("click", async (event) => {
                        const songId = event.target.getAttribute("data-id");
                        if (confirm("Are you sure you want to delete this song?")) {
                            try {
                                const response = await fetch(`/musicfeed/${songId}`, {
                                    method: "DELETE"
                                });

                                if (response.ok) {
                                    event.target.parentElement.remove(); // Remove the song from the list
                                } else {
                                    alert("Failed to delete the song.");
                                }
                            } catch (error) {
                                console.error("Error deleting song:", error);
                            }
                        }
                    });
                });
            });
        </script>

</body>
</html>
